# Local development placeholders for Milestone 2.
# Copy this file to .env and replace placeholder segments for your own machine.
# Do not treat this file as production configuration.

HERBWIRE_DATABASE_URL=postgresql+psycopg://<local-user>:<local-password>@127.0.0.1:5433/<local-database-name>
HERBWIRE_ENVIRONMENT=local
HERBWIRE_FRONTEND_ORIGIN=http://127.0.0.1:5173
HERBWIRE_API_HOST=127.0.0.1
HERBWIRE_API_PORT=8000
HERBWIRE_POSTGRES_PORT=5433
HERBWIRE_ADMIN_EMAIL=admin@example.invalid
HERBWIRE_ADMIN_PASSWORD=replace-with-a-local-password
HERBWIRE_SESSION_SECRET=replace-with-a-long-random-secret
HERBWIRE_SESSION_COOKIE_NAME=herbwire_editor_session
HERBWIRE_SESSION_COOKIE_SECURE=false
HERBWIRE_ENABLE_DEVELOPMENT_ENDPOINTS=true
HERBWIRE_ALLOW_DESTRUCTIVE_TEST_DB=false
VITE_HERBWIRE_API_BASE_URL=http://127.0.0.1:8000

# Optional Zyte configuration. Leave unset for ordinary local tests.
HERBWIRE_ZYTE_SCRAPY_CLOUD_API_KEY=
HERBWIRE_ZYTE_SCRAPY_CLOUD_PROJECT_ID=
HERBWIRE_ZYTE_API_KEY=
HERBWIRE_ZYTE_REQUEST_TIMEOUT_SECONDS=10
HERBWIRE_ZYTE_MAX_RETRIES=2

# No Heroku credential is configured today.
# No Zyte cloud action is authorized today.
